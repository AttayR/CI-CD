# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  # Setup App Store Connect API Key
  desc "Setup App Store Connect API Key"
  lane :setup_api_key do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8"),
      in_house: false
    )
  end

  # Staging lane - for testing/QA (TestFlight)
  desc "Build and upload to TestFlight for staging/testing"
  lane :staging do
    # Setup API key for authentication
    setup_api_key
    
    # Sync certificates and provisioning profiles
    match(
      type: "appstore",
      readonly: true,
      app_identifier: "com.cicdhose.app"
    )
    
    # Increment build number
    increment_build_number(
      xcodeproj: "rn_ci_cd.xcodeproj"
    )
    
    # Build and upload to TestFlight
    build_app(
      scheme: "appwriteAuth",
      workspace: "rn_ci_cd.xcworkspace",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.cicdhose.app" => "match AppStore com.cicdhose.app"
        }
      }
    )
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  # Production lane - for main branch (App Store)
  desc "Build and upload to App Store for production"
  lane :production do
    # Setup API key for authentication
    setup_api_key
    
    # Sync certificates and provisioning profiles
    match(
      type: "appstore",
      readonly: true,
      app_identifier: "com.cicdhose.app"
    )
    
    # Increment build number
    increment_build_number(
      xcodeproj: "rn_ci_cd.xcodeproj"
    )
    
    # Build and upload to App Store
    build_app(
      scheme: "appwriteAuth",
      workspace: "rn_ci_cd.xcworkspace",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.cicdhose.app" => "match AppStore com.cicdhose.app"
        }
      }
    )
    
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false
    )
  end

  # Optional: Test lane
  desc "Run iOS tests"
  lane :tests do
    scan(
      scheme: "appwriteAuth"
    )
  end
end
