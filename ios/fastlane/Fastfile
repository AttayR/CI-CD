# Fastlane configuration for iOS CI/CD
# Documentation: https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  
  # ==================== SHARED: API KEY SETUP ====================
  before_all do
    # Setup App Store Connect API Key from environment variables
    if ENV["APP_STORE_CONNECT_API_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8"),
        in_house: false
      )
    end
  end

  # ==================== STAGING: TestFlight ====================
  desc "Build and upload to TestFlight for staging/testing"
  lane :staging do
    # Fetch certificates and profiles
    match(
      type: "appstore",
      readonly: is_ci
    )

    # Increment build number
    increment_build_number(
      xcodeproj: "rn_ci_cd.xcodeproj"
    )

    # Build the app
    build_app(
      scheme: "appwriteAuth",
      workspace: "rn_ci_cd.xcworkspace",
      export_method: "app-store",
      clean: true
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("✅ Successfully uploaded to TestFlight!")
  end

  # ==================== PRODUCTION: App Store ====================
  desc "Build and upload to App Store for production"
  lane :production do
    # Fetch certificates and profiles
    match(
      type: "appstore",
      readonly: is_ci
    )

    # Increment build number
    increment_build_number(
      xcodeproj: "rn_ci_cd.xcodeproj"
    )

    # Build the app
    build_app(
      scheme: "appwriteAuth",
      workspace: "rn_ci_cd.xcworkspace",
      export_method: "app-store",
      clean: true
    )

    # Upload to App Store
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )

    UI.success("✅ Successfully uploaded to App Store!")
  end

  # ==================== TESTS ====================
  desc "Run iOS tests"
  lane :tests do
    scan(
      scheme: "appwriteAuth",
      clean: true
    )
  end

  # ==================== CERTIFICATES ====================
  desc "Sync certificates and profiles"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: false
    )
    match(
      type: "development",
      readonly: false
    )
  end

end
