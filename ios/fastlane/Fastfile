# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  # Staging lane - for testing/QA (TestFlight)
  desc "Build and upload to TestFlight for staging/testing"
  lane :staging do
    # Increment build number
    increment_build_number(
      xcodeproj: "rn_ci_cd.xcodeproj"
    )
    
    # Build and upload to TestFlight
    build_app(
      scheme: "rn_ci_cd",
      workspace: "rn_ci_cd.xcworkspace",
      export_method: "app-store",
      skip_codesigning: false,
      skip_package_ipa: false
    )
    
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end

  # Production lane - for main branch (App Store)
  desc "Build and upload to App Store for production"
  lane :production do
    # Increment build number
    increment_build_number(
      xcodeproj: "rn_ci_cd.xcodeproj"
    )
    
    # Build and upload to App Store
    build_app(
      scheme: "rn_ci_cd",
      workspace: "rn_ci_cd.xcworkspace",
      export_method: "app-store",
      skip_codesigning: false,
      skip_package_ipa: false
    )
    
    upload_to_app_store(
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false
    )
  end

  # Optional: Test lane
  desc "Run iOS tests"
  lane :tests do
    scan(
      scheme: "rn_ci_cd"
    )
  end
